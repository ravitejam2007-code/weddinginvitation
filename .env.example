# Set to the hosts' WhatsApp number in international format, digits only.
# This is a guest-opened fallback and does not provide delivery confirmation.
VITE_WEDDING_RSVP_WHATSAPP_NUMBER=

# Set to an HTTPS endpoint that accepts JSON POST bodies for RSVP submissions.
# Expected success: any 2xx response. Leave empty until a backend/form service exists.
VITE_WEDDING_RSVP_ENDPOINT=

# Optional approved audio file URL. The player stays disabled until set.
VITE_WEDDING_MUSIC_URL=
